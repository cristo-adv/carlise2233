          <td>{{ c.responsavel or '-' }}</td>
          <td><span class="badge b-{{ 'verde' if c.status == 'ATIVO' else ('amarelo' if c.status == 'PENDENTE' else 'cinza') }}">{{ c.status }}</span></td>
