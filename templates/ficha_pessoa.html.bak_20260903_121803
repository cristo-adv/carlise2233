          </td>
        </tr>
      {% else %}
        <tr><td colspan="10">Nenhum contrato.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<div class="painel" id="p-demandas">
  <div class="card">
    <h2>Demandas</h2>
    <form method="post" action="{{ alvo }}/demandas/salvar">
      <div class="mini">
        <div><label>Tipo de Demanda</label>
          <select name="tipo"><option value="">SELECIONE</option>
            {% for td in tipos_demanda %}<option value="{{ td }}">{{ td }}</option>{% endfor %}
          </select></div>
        <div><label>Descricao</label><input name="descricao" value="" data-up></div>
        <div><label>Filtrar Responsavel</label>
          <select id="filtroResp" onchange="carregarResp('selResp', this.value, '')"><option value="">TODOS</option>
            {% for fr in filtros_responsavel %}<option value="{{ fr }}">{{ fr }}</option>{% endfor %}
          </select></div>
        <div><label>Responsavel (do Cadastro)</label>
          <select name="responsavel" id="selResp"><option value="">CARREGANDO...</option></select></div>
        <div><label>Municipio (padrao do cadastro)</label>
          <input name="municipio" value="{{ p.municipio if p else '' }}" data-up></div>
        <div><label>Prioridade</label>
          <select name="prioridade">{% for pr in prioridades %}<option>{{ pr }}</option>{% endfor %}</select></div>
        <div><label>Data</label><input type="date" name="data" value=""></div>
        <div><label>Status</label>
          <select name="status"><option>PENDENTE</option><option>EM ANDAMENTO</option><option>CONCLUIDA</option></select></div>
      </div>
      <button class="btn btn-p" type="submit">Adicionar Demanda</button>
    </form>
    <table style="margin-top:10px">
      <thead><tr><th>Tipo</th><th>Descricao</th><th>Responsavel</th><th>Municipio</th><th>Prioridade</th><th>Data</th><th>Status</th><th></th></tr></thead>
      <tbody>
      {% for d in p.demandas %}
        <tr>
          <td>{{ d.tipo }}</td><td>{{ d.descricao }}</td><td>{{ d.responsavel or '-' }}</td><td>{{ d.municipio or '-' }}</td>
          <td><span class="badge b-{{ 'vermelho' if d.prioridade == 'ALTA' else ('amarelo' if d.prioridade == 'MEDIA' else 'azul') }}">{{ d.prioridade or '-' }}</span></td>
          <td>{{ d.data }}</td>
          <td><span class="badge b-{{ 'verde' if d.status == 'CONCLUIDA' else ('amarelo' if d.status == 'PENDENTE' else 'azul') }}">{{ d.status }}</span></td>
          <td>
            <button class="btn btn-s" type="button" onclick="editarDemanda({{ d.id }})">Editar</button>
            <form method="post" action="/demandas/{{ d.id }}/excluir" style="display:inline"><button class="btn btn-e" type="submit">Excluir</button></form>
          </td>
        </tr>
      {% else %}
        <tr><td colspan="8">Nenhuma demanda.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</div>

