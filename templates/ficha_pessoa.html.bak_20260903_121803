<script>
/* ===== Kit - Grade Categorizada (isolado - nunca quebra as abas) ===== */
try {
  (function(){
    function atualizarKPI(){
      var total = 0, qtd = 0, vols = 0;
      var sel = document.querySelectorAll('.chk-mat:checked');
      sel.forEach(function(c){
        total++;
        var chave = c.getAttribute('data-chave');
        var q = parseInt((document.querySelector('.qtd-mat[data-chave="' + chave + '"]') || {}).value || '0', 10) || 0;
        qtd += q;
        var v = (document.querySelector('.vol-mat[data-chave="' + chave + '"]') || {}).value || '';
        if(v){ vols++; }
      });
      document.getElementById('kpiMateriais').textContent = total;
      document.getElementById('kpiQtd').textContent = qtd;
      document.getElementById('kpiVolumes').textContent = vols;
      var lista = document.getElementById('listaSelecao');
      if(total === 0){
        lista.innerHTML = 'Nenhum material selecionado.';
      } else {
        var html = '<table><thead><tr><th>Material</th><th>Qtd</th><th>Vol</th></tr></thead><tbody>';
        sel.forEach(function(c){
          var chave = c.getAttribute('data-chave');
          var nome = c.getAttribute('data-nome');
          var q = (document.querySelector('.qtd-mat[data-chave="' + chave + '"]') || {}).value || '0';
          var v = (document.querySelector('.vol-mat[data-chave="' + chave + '"]') || {}).value || '-';
          html += '<tr><td>' + nome + '</td><td>' + q + '</td><td>' + v + '</td></tr>';
        });
        html += '</tbody></table>';
        lista.innerHTML = html;
      }
    }
    window.atualizarKPI = atualizarKPI;
    window.limparSelecao = function(){
      document.querySelectorAll('.chk-mat').forEach(function(c){ c.checked = false; });
      document.querySelectorAll('.qtd-mat').forEach(function(q){ q.value = ''; });
      document.querySelectorAll('.vol-mat').forEach(function(v){ v.value = ''; });
      atualizarKPI();
    };
    document.querySelectorAll('.chk-mat').forEach(function(c){
      c.addEventListener('change', atualizarKPI);
    });
    document.querySelectorAll('.qtd-mat').forEach(function(q){
      q.addEventListener('input', atualizarKPI);
    });
    document.querySelectorAll('.vol-mat').forEach(function(v){
      v.addEventListener('change', atualizarKPI);
    });
    // Filtro por categoria
    var filtro = document.getElementById('filtroCategorias');
    if(filtro){
      filtro.addEventListener('click', function(ev){
        var btn = ev.target.closest('button');
        if(!btn){ return; }
        var cat = btn.getAttribute('data-cat');
        filtro.querySelectorAll('button').forEach(function(b){ b.classList.remove('btn-p'); b.classList.add('btn-s'); });
        btn.classList.remove('btn-s'); btn.classList.add('btn-p');
        document.querySelectorAll('.grupo-categoria').forEach(function(g){
          g.style.display = (cat === '' || g.getAttribute('data-grupo') === cat) ? '' : 'none';
        });
      });
    }
    atualizarKPI();
  })();
} catch(e) {}
</script>


