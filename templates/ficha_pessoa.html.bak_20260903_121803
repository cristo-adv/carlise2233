<script>
/* ===== 1) ABAS (primeiro e mais critico - nunca quebra) ===== */
try {
  (function(){
    function ativa(aba){
      var paineis = document.querySelectorAll('.painel');
      for(var i = 0; i < paineis.length; i++){
        paineis[i].classList.remove('ativa');
        if(paineis[i].id === 'p-' + aba){ paineis[i].classList.add('ativa'); }
      }
      var abas = document.querySelectorAll('.aba');
      for(var j = 0; j < abas.length; j++){
        abas[j].classList.remove('ativa');
        if(abas[j].getAttribute('data-t') === aba){ abas[j].classList.add('ativa'); }
      }
    }
    var barra = document.getElementById('barraAbas');
    if(barra){
      barra.addEventListener('click', function(ev){
        var alvo = ev.target;
        if(alvo && alvo.classList && alvo.classList.contains('aba')){
          ativa(alvo.getAttribute('data-t'));
        }
      });
    }
    var ini = new URLSearchParams(window.location.search).get('aba');
    if(ini && document.getElementById('p-' + ini)){ ativa(ini); }
    if(!document.querySelector('.painel.ativa')){
      var primeiro = document.querySelector('.painel');
      if(primeiro){ primeiro.classList.add('ativa'); }
    }
  })();
} catch(e) {}

/* ===== 2) RESPONSAVEL (funcao global - carrega pessoas do cadastro) ===== */
function carregarResp(selId, tipo, valorAtual){
  var sel = document.getElementById(selId);
  if(!sel){ return; }
  sel.innerHTML = '<option value="">CARREGANDO...</option>';
  fetch('/api/pessoas_opcoes?tipo=' + encodeURIComponent(tipo || '')).then(function(r){
    return r.json();
  }).then(function(dados){
    sel.innerHTML = '<option value="">SELECIONE</option>';
    (dados || []).forEach(function(pp){
      var op = document.createElement('option');
      op.value = pp.nome;
      op.textContent = pp.nome;
      sel.appendChild(op);
    });
    if(valorAtual){ sel.value = valorAtual; }
  }).catch(function(){
    sel.innerHTML = '<option value="">ERRO AO CARREGAR</option>';
  });
}

/* ===== 3) Mascaras ===== */
try {
  (function(){
    function fmt(v, tipo){
      if(tipo === 'cpf'){
        var c = (v || '').replace(/\D/g, '').slice(0, 11);
        return c.replace(/(\d{3})(\d)/, '$1.$2').replace(/(\d{3})\.(\d{3})(\d)/, '$1.$2.$3').replace(/(\d{3})\.(\d{3})\.(\d{3})(\d)/, '$1.$2.$3-$4');
      }
      if(tipo === 'cep'){
        var e = (v || '').replace(/\D/g, '').slice(0, 8);
        return e.replace(/(\d{5})(\d)/, '$1-$2');
      }
      if(tipo === 'fone'){
        var f = (v || '').replace(/\D/g, '').slice(0, 10);
        return f.replace(/(\d{2})(\d)/, '($1) $2').replace(/(\d{4})(\d)/, '$1-$2');
      }
      if(tipo === 'cel'){
        var m = (v || '').replace(/\D/g, '').slice(0, 11);
        return m.replace(/(\d{2})(\d)/, '($1) $2').replace(/(\d{5})(\d)/, '$1-$2');
      }
      if(tipo === 'placa'){
        var p = (v || '').toUpperCase().replace(/[^A-Z0-9]/g, '').slice(0, 7);
        if(p.length > 3){ p = p.slice(0, 3) + '-' + p.slice(3); }
        return p;
      }
      return v;
    }
    document.querySelectorAll('[data-mask]').forEach(function(el){
      var tipo = el.getAttribute('data-mask');
      el.addEventListener('input', function(){
        var d = el.value.replace(/\D/g, '');
        var ant = el.dataset.ant || '';
        if(d.length >= ant.length){ el.value = fmt(el.value, tipo); }
        el.dataset.ant = d;
      });
      el.addEventListener('blur', function(){ el.value = fmt(el.value, tipo); });
      el.value = fmt(el.value, tipo);
    });
    document.querySelectorAll('[data-up]').forEach(function(el){
      el.addEventListener('input', function(){
        var n = el.value.toUpperCase();
        if(n !== el.value){ el.value = n; }
      });
      el.value = (el.value || '').toUpperCase();
    });
  })();
} catch(e) {}

/* ===== 4) Moeda ===== */
try {
  (function(){
    function fmtMoeda(v){
      var t = (v || '').replace('R$', '').trim();
      if(!t){ return ''; }
      var neg = false;
      if(t.charAt(0) === '-'){ neg = true; t = t.slice(1).trim(); }
      t = t.replace(/\./g, '');
      var partes = t.split(',');
      var inteiro = (partes[0] || '').replace(/\D/g, '') || '0';
      var dec = ((partes[1] || '').replace(/\D/g, '') + '00').slice(0, 2);
      var num = parseInt(inteiro, 10);
      var fmt = num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
      return (neg ? '-' : '') + 'R$ ' + fmt + ',' + dec;
    }
    document.querySelectorAll('[data-moeda]').forEach(function(el){
      el.addEventListener('blur', function(){ el.value = fmtMoeda(el.value); });
    });
  })();
} catch(e) {}

/* ===== 5) CPF ===== */
try {
  (function(){
    var idAtual = (document.getElementById('idCampo') || {}).value || '';
    var cpf = document.getElementById('cpfCampo');
    if(cpf){
      function verificaCpf(){
        var v = cpf.value.replace(/\D/g, '');
        var st = document.getElementById('cpfStatus');
        if(v.length !== 11){ st.textContent = ''; return; }
        fetch('/api/pessoa_por_cpf/' + v).then(function(r){ return r.json(); }).then(function(d){
          if(d.existe){
            if(d.pessoa && String(d.pessoa.id) === String(idAtual)){
              st.textContent = 'CPF OK (este registro)'; st.style.color = '#7CFC9E';
            } else {
              st.textContent = 'CPF ja cadastrado: ' + (d.pessoa ? d.pessoa.nome : '') + ' (ID ' + (d.pessoa ? d.pessoa.id : '') + ')';
              st.style.color = '#ff9d9d';
            }
          } else {
            st.textContent = 'CPF disponivel'; st.style.color = '#7CFC9E';
          }
        }).catch(function(){ st.textContent = ''; });
      }
      cpf.addEventListener('blur', function(){ verificaCpf(); });
      cpf.addEventListener('keyup', function(){ if(cpf.value.replace(/\D/g, '').length === 11){ verificaCpf(); } });
    }
  })();
} catch(e) {}

/* ===== 6) CEP ===== */
try {
  (function(){
    var cepEl = document.getElementById('cepCampo');
    if(cepEl){
      cepEl.addEventListener('blur', function(){
        var c = cepEl.value.replace(/\D/g, '');
        var st = document.getElementById('cepStatus');
        if(c.length !== 8){ return; }
        st.textContent = 'Buscando CEP...'; st.style.color = '#FFE873';
        fetch('https://viacep.com.br/ws/' + c + '/json/').then(function(r){ return r.json(); }).then(function(d){
          if(d && !d.erro){
            var end = document.getElementById('enderecoCampo');
            var bai = document.getElementById('bairroCampo');
            var mun = document.getElementById('municipioCampo');
            if(end){ end.value = (d.logradouro || '').toUpperCase(); }
            if(bai){ bai.value = (d.bairro || '').toUpperCase(); }
            if(mun){ mun.value = (d.localidade || '').toUpperCase(); }
            st.textContent = 'CEP encontrado'; st.style.color = '#7CFC9E';
          } else {
            st.textContent = 'CEP nao encontrado'; st.style.color = '#ff9d9d';
          }
        }).catch(function(){ st.textContent = 'Erro ao buscar CEP'; st.style.color = '#ff9d9d'; });
      });
    }
  })();
} catch(e) {}

