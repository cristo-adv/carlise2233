
<script>
/* ===== ABAS - funcao global inline (a mais robusta possivel) ===== */
function ativaAba(aba){
  var paineis = document.querySelectorAll('.painel');
  for(var i=0;i<paineis.length;i++){ paineis[i].classList.remove('ativa'); }
  var alvo = document.getElementById('p-'+aba);
  if(alvo){ alvo.classList.add('ativa'); }
  var abas = document.querySelectorAll('.aba');
  for(var j=0;j<abas.length;j++){ abas[j].classList.remove('ativa'); }
  var ab = document.querySelector('.aba[data-t="'+aba+'"]');
  if(ab){ ab.classList.add('ativa'); }
}
</script>

{% extends "base.html" %}
{% block conteudo %}
{% if p %}
<h1>{{ p.nome or 'Sem nome' }}</h1>
<div class="sub">
  {% if p.cpf %}CPF: {{ p.cpf }} | {% endif %}
  {% if p.tipo %}{{ p.tipo }} | {% endif %}
  {% if p.funcao %}{{ p.funcao }} | {% endif %}
  {% if p.municipio %}{{ p.municipio }}{% endif %}
</div>
{% else %}
<h1>Novo Cadastro</h1>
<div class="sub">Preencha os dados e clique em Salvar</div>
{% endif %}

{% if p %}
<div class="abas" id="barraAbas">
  <span class="aba" data-t="cadastro" onclick="ativaAba('cadastro')">Cadastro</span>
  <span class="aba" data-t="titulo" onclick="ativaAba('titulo')">Titulo de Eleitor</span>
  <span class="aba" data-t="veiculos" onclick="ativaAba('veiculos')">Veiculos</span>
  <span class="aba" data-t="contratos" onclick="ativaAba('contratos')">Contratos</span>
  <span class="aba" data-t="demandas" onclick="ativaAba('demandas')">Demandas</span>
  <span class="aba" data-t="doacoes" onclick="ativaAba('doacoes')">Doacoes</span>
  <span class="aba" data-t="cargos" onclick="ativaAba('cargos')">Cargos</span>
  <span class="aba" data-t="autorizacoes" onclick="ativaAba('autorizacoes')">Autorizacoes</span>
  <span class="aba" data-t="kit" onclick="ativaAba('kit')">Kit</span>
</div>
{% endif %}

<div class="painel {{ 'ativa' if (aba == 'cadastro' or not p) else '' }}" id="p-cadastro">
  <div class="card">
    <form method="post" action="/pessoas/salvar" id="formCadastro">
      <input type="hidden" name="id" value="{{ p.id if p else '' }}" id="idCampo">
      <div class="grade">
        <div><label>CPF (verificacao)</label>
          <input type="text" name="cpf" id="cpfCampo" value="{{ p.cpf if p else '' }}" data-mask="cpf" maxlength="14" placeholder="000.000.000-00">
          <span id="cpfStatus" style="font-size:11px;color:var(--cinza)"></span></div>
        <div><label>Tratamento</label>
          <select name="tratamento"><option value="">SELECIONE</option>
            {% for t in tratamentos %}<option value="{{ t }}" {{ 'selected' if p and (p.tratamento or '').upper() == t }}>{{ t }}</option>{% endfor %}
          </select></div>
        <div><label>Nome Completo *</label>
          <input type="text" name="nome" value="{{ p.nome if p else '' }}" required data-up></div>
        <div><label>RG</label>
          <input type="text" name="rg" value="{{ p.rg if p else '' }}" placeholder="somente letras e numeros" data-up maxlength="20"></div>
        <div><label>Nascimento</label>
          <input type="date" name="nascimento" value="{{ p.nascimento if p else '' }}"></div>
        <div><label>CEP (auto preenchimento)</label>
          <input type="text" name="cep" id="cepCampo" value="{{ p.cep if p else '' }}" data-mask="cep" maxlength="9" placeholder="00000-000">
          <span id="cepStatus" style="font-size:11px;color:var(--cinza)"></span></div>
        <div><label>Numero</label>
          <input type="text" name="numero" value="{{ p.numero if p else '' }}" data-up></div>
        <div><label>Complemento</label>
          <input type="text" name="complemento" value="{{ p.complemento if p else '' }}" placeholder="APTO, BLOCO, CASA..." data-up></div>
        <div><label>Endereco (logradouro)</label>
          <input type="text" name="endereco" id="enderecoCampo" value="{{ p.endereco if p else '' }}" data-up></div>
        <div><label>Bairro</label>
          <input type="text" name="bairro" id="bairroCampo" value="{{ p.bairro if p else '' }}" data-up></div>
        <div><label>Municipio</label>
          <input type="text" name="municipio" id="municipioCampo" value="{{ p.municipio if p else '' }}" data-up></div>
        <div><label>Telefone</label>
          <input type="text" name="telefone" value="{{ p.telefone if p else '' }}" data-mask="fone" maxlength="14" placeholder="(00) 0000-0000"></div>
        <div><label>Celular</label>
          <input type="text" name="celular" value="{{ p.celular if p else '' }}" data-mask="cel" maxlength="15" placeholder="(00) 00000-0000"></div>
        <div><label>E-mail (minusculo automatico)</label>
          <input type="text" name="email" value="{{ p.email if p else '' }}" oninput="this.value=this.value.toLowerCase()" style="text-transform:lowercase" placeholder="email@exemplo.com"></div>
        <div><label>Tipo</label>
          <select name="tipo"><option value="">SELECIONE</option>
            {% for t in tipos %}<option value="{{ t }}" {{ 'selected' if p and (p.tipo or '').upper() == t }}>{{ t }}</option>{% endfor %}
          </select></div>
        <div><label>Funcao</label>
          <select name="funcao"><option value="">SELECIONE</option>
            {% for fn in funcoes %}<option value="{{ fn }}" {{ 'selected' if p and (p.funcao or '').upper() == fn }}>{{ fn }}</option>{% endfor %}
          </select></div>
        <div><label>Estado Civil</label>
          <input type="text" name="estado_civil" value="{{ p.estado_civil if p else '' }}" data-up></div>
      </div>
      <label style="margin-top:10px">Observacoes</label>
      <textarea name="observacoes" rows="2" data-up>{{ p.observacoes if p else '' }}</textarea>
      <div style="margin-top:12px">
        <button class="btn btn-p" type="submit">Salvar</button>
        <a class="btn btn-s" href="/pessoas">Voltar</a>
      </div>
    </form>
    {% if p %}
    <form method="post" action="/pessoas/{{ p.id }}/excluir" style="margin-top:4px" onsubmit="return confirm('Excluir este registro e todos os vinculos permanentemente?');">
      <button class="btn btn-e" type="submit">Excluir</button>
    </form>
    {% endif %}
  </div>
</div>

<div class="painel {{ 'ativa' if aba == 'titulo' else '' }}" id="p-titulo">
  <div class="card">
    <h2>Titulo de Eleitor</h2>
    <div class="mini">
      <div><label>Titulo de Eleitor</label>
        <input type="text" name="titulo_eleitor" form="formCadastro" value="{{ p.titulo_eleitor if p else '' }}" oninput="this.value=this.value.replace(/\D/g,'')" maxlength="12"></div>
      <div><label>Zona</label>
        <input type="text" name="zona" form="formCadastro" value="{{ p.zona if p else '' }}" oninput="this.value=this.value.replace(/\D/g,'')" maxlength="6"></div>
      <div><label>Secao</label>
        <input type="text" name="secao" form="formCadastro" value="{{ p.secao if p else '' }}" oninput="this.value=this.value.replace(/\D/g,'')" maxlength="6"></div>
      <div><label>Local de Votacao</label>
        <input type="text" name="local_votacao" form="formCadastro" value="{{ p.local_votacao if p else '' }}" data-up></div>
    </div>
    <div style="margin-top:12px">
      <button class="btn btn-p" type="submit" form="formCadastro">Salvar</button>
      {% if p %}<a class="btn btn-s" href="/pessoas">Voltar</a>{% endif %}
    </div>
  </div>
</div>

{% if p %}
{% set pid = p.id %}
{% set alvo = '/pessoas/' ~ pid %}

<div class="painel" id="p-veiculos">
  <div class="card">
    <h2>Veiculos</h2>
    <form method="post" action="{{ alvo }}/veiculos/salvar">
      <div class="mini">
        <div><label>Placa</label>
          <input name="placa" value="" data-mask="placa" maxlength="8" placeholder="ABC-1D23"></div>
        <div><label>Modelo</label>
          <select name="modelo"><option value="">SELECIONE</option>
            {% for m in modelos_veiculos %}<option value="{{ m }}">{{ m }}</option>{% endfor %}
          </select></div>
        <div><label>Tipo</label>
          <select name="tipo"><option value="">SELECIONE</option>
            <option>CARRO</option><option>MOTO</option><option>CAMINHONETE</option><option>UTILITARIO</option><option>VAN</option>
          </select></div>
        <div><label>Combustivel</label>
          <select name="combustivel"><option value="">SELECIONE</option>
            {% for c in combustiveis %}<option value="{{ c }}">{{ c }}</option>{% endfor %}
          </select></div>
        <div><label>Tipo de Veiculo</label>
          <select name="tipo_veiculo"><option value="">SELECIONE</option>
            {% for tv in tipos_veiculo %}<option value="{{ tv }}">{{ tv }}</option>{% endfor %}
          </select></div>
        <div><label>Adesivagem</label>
          <select name="adesivagem"><option value="">SELECIONE</option>
            <option>SO CANDIDATA</option><option>CANDIDATA + DEP. ESTADUAL</option>
            <option>CANDIDATA + GOVERNADOR</option><option>CANDIDATA + SENADOR</option>
            <option>CANDIDATA + PRESIDENTE</option><option>TODOS</option>
          </select></div>
        <div><label>Motorista / Responsavel</label>
          <input name="motorista" value="" data-up></div>
        <div><label>Municipio / Regiao</label>
          <input name="municipio" value="" data-up></div>
        <div><label>Status</label>
          <select name="status"><option>RODANDO</option><option>PARADO</option><option>MANUTENCAO</option></select></div>
      </div>
      <button class="btn btn-p" type="submit">Adicionar Veiculo</button>
    </form>
    <table style="margin-top:10px">
      <thead><tr><th>Placa</th><th>Modelo</th><th>Tipo</th><th>Combustivel</th><th>Tipo Veiculo</th><th>Adesivagem</th><th>Motorista</th><th>Municipio</th><th>Status</th><th></th></tr></thead>
      <tbody>
      {% for v in p.veiculos %}
        <tr>
          <td>{{ v.placa }}</td><td>{{ v.modelo }}</td><td>{{ v.tipo }}</td><td>{{ v.combustivel or '-' }}</td>
          <td>{{ v.tipo_veiculo or '-' }}</td><td>{{ v.adesivagem }}</td><td>{{ v.motorista or '-' }}</td><td>{{ v.municipio }}</td>
          <td><span class="badge b-{{ 'verde' if v.status == 'RODANDO' else ('amarelo' if v.status == 'PARADO' else 'azul') }}">{{ v.status }}</span></td>
          <td>
            <button class="btn btn-s" type="button" onclick="editarVeiculo({{ v.id }})">Editar</button>
            <form method="post" action="/veiculos/{{ v.id }}/excluir" style="display:inline"><button class="btn btn-e" type="submit">Excluir</button></form>
          </td>
        </tr>
      {% else %}
        <tr><td colspan="10">Nenhum veiculo.</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</div>

