<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Entrar - CARLISE 2233</title>
<link rel="stylesheet" href="/static/estilo.css">
</head>
<body>
<div class="central card">
  <div class="marca">
    <div class="t"><b>CARLISE</b> 2233</div>
    <div class="s">Sistema de Gestao Eleitoral</div>
  </div>
  {% with msgs = get_flashed_messages(with_categories=true) %}
    {% for cat, msg in msgs %}<div class="flash {{ cat }}">{{ msg }}</div>{% endfor %}
  {% endwith %}
  <form method="post" action="/login">
    <label>Usuario</label>
    <input type="text" name="usuario" autofocus required>
    <label>Senha</label>
    <input type="password" name="senha" required>
    <button class="btn btn-p" type="submit" style="width:100%;margin-top:12px">Entrar</button>
  </form>
</div>
</body>
</html>