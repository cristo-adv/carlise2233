@app.route("/pessoas/salvar", methods=["POST"])
@login_obrigatorio
def pessoa_salvar():
    pid_txt = sane(request.form.get("id"))
    try:
        pid = int(pid_txt) if pid_txt else 0
    except ValueError:
        pid = 0
    valores = {}
    for c in CAMPOS_PESSOA:
        v = sane(request.form.get(c))
        if c == "cpf":
            v = dig(v)
        elif c == "email":
            v = v.lower()
        elif c in ("tipo", "funcao", "tratamento", "rg"):
            v = norm_txt(v)
        valores[c] = v
    if not valores.get("nome"):
        flash("Informe o Nome.", "erro")
        return redirect(url_for("pessoas"))
    cpf = valores.get("cpf") or ""
    if cpf and len(cpf) != 11:
        flash("CPF deve ter 11 digitos.", "erro")
        return redirect(url_for("pessoas"))
    if cpf:
        dup = buscar("SELECT id FROM pessoas WHERE cpf=%s AND id<>%s", (cpf, pid))
        if dup:
            flash("CPF ja cadastrado em outro registro (id %s)." % dup.get("id"), "erro")
            return redirect("/pessoas/%s?aba=cadastro" % dup.get("id"))
    params = [valores[c] for c in CAMPOS_PESSOA]
    if pid:
        pares = ", ".join(c + "=%s" for c in CAMPOS_PESSOA)
        alterar("UPDATE pessoas SET " + pares + " WHERE id=%s", params + [pid])
        return redirect("/pessoas/%d?aba=cadastro&ok=1" % pid)
    novo_id = inserir("INSERT INTO pessoas (" + ", ".join(CAMPOS_PESSOA) + ") VALUES (" +
                      ", ".join(["%s"] * len(CAMPOS_PESSOA)) + ")", params)
    if novo_id:
        return redirect("/pessoas/%d?aba=cadastro&ok=1" % novo_id)
    flash("Nao foi possivel salvar.", "erro")
    return redirect(url_for("pessoas"))

def montar_ficha(pid):
    p = buscar("SELECT * FROM pessoas WHERE id=%s", (pid,))
    if not p:
        return None
    p["veiculos"] = listar("SELECT * FROM veiculos WHERE pessoa_id=%s ORDER BY id DESC", (pid,))
    p["contratos"] = listar("SELECT * FROM contratos WHERE pessoa_id=%s ORDER BY id DESC", (pid,))
    p["demandas"] = listar("SELECT * FROM demandas WHERE pessoa_id=%s ORDER BY id DESC", (pid,))
    p["doacoes"] = listar("SELECT * FROM doacoes WHERE pessoa_id=%s ORDER BY id DESC", (pid,))
    p["cargos"] = listar("SELECT * FROM cargos WHERE pessoa_id=%s ORDER BY id DESC", (pid,))
    p["autorizacoes"] = listar("SELECT * FROM autorizacoes WHERE pessoa_id=%s ORDER BY id DESC", (pid,))
    kits = listar("SELECT * FROM kits WHERE pessoa_id=%s ORDER BY id DESC", (pid,))
    for k in kits:
        k["itens"] = listar("SELECT * FROM kit_itens WHERE kit_id=%s ORDER BY id", (k.get("id"),))
    p["kits"] = kits
    return p

