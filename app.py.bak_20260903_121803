USAR_PG = bool(URL)

def conectar():
    if USAR_PG:
        import psycopg2
        return psycopg2.connect(URL)
    conn = sqlite3.connect(os.path.join(BASE_DIR, "sistema.db"))
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys=ON")
    return conn

def get_db():
    if "conn" not in g:
        g.conn = conectar()
    return g.conn

@app.teardown_appcontext
def fechar(exc):
    conn = g.pop("conn", None)
    if conn is not None:
        try:
            conn.commit() if not exc else conn.rollback()
        except Exception:
            pass
        try:
            conn.close()
        except Exception:
            pass

def prep(sql):
    return sql.replace("%s", "?") if not USAR_PG else sql

def executar(sql, params=()):
    cur = get_db().cursor()
    cur.execute(prep(sql), tuple(params))
    return cur

def alterar(sql, params=()):
    executar(sql, params)
    get_db().commit()

def inserir(sql, params=()):
    cur = executar(sql + (" RETURNING id" if USAR_PG else ""), params)
    get_db().commit()
    if USAR_PG:
        linha = cur.fetchone()
        return linha[0] if linha else None
    return cur.lastrowid

def listar(sql, params=()):
    cur = executar(sql, params)
    linhas = cur.fetchall()
    if not linhas:
        return []
    if isinstance(linhas[0], dict):
        return [dict(l) for l in linhas]
    if hasattr(linhas[0], "keys"):
        return [dict(l) for l in linhas]
    cols = [d[0] for d in cur.description]
    return [dict(zip(cols, l)) for l in linhas]

def buscar(sql, params=()):
    linhas = listar(sql, params)
    return linhas[0] if linhas else None

def contar(tabela):
    lin = buscar("SELECT COUNT(*) AS n FROM " + tabela)
    return (lin or {}).get("n") or 0

def sane(v):
    return (v or "").strip()

def dig(v):
    return re.sub(r"\D", "", v or "")

def norm_txt(v):
    return sane(v).upper()

def parse_moeda(v):
    """Converte 'R$ 1.500,00' / '1500' / '1500,50' em numero float."""
    t = (v or "").replace("R$", "").replace(" ", "").replace(".", "").replace(",", ".")
    try:
        return float(t) or 0
    except ValueError:
        return 0


def colunas_existem(cur, tabela):
    if USAR_PG:
        cur.execute("SELECT column_name FROM information_schema.columns WHERE table_name=%s", (tabela,))
        return [r[0] for r in cur.fetchall()]
    cur.execute("PRAGMA table_info(" + tabela + ")")
    return [r[1] for r in cur.fetchall()]

